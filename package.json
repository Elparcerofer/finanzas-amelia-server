{
  "name": "finanzas-movile-amelia-backend",
  "version": "1.0.0",
  "description": "Backend de finanzas personales (Amelia) - Node.js + TypeScript + Express + MySQL",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only index.ts",
    "build": "rimraf ./dist && tsc",
    "start": "node dist/index.js",
    "lint": "tslint -p tsconfig.json",
    "migrate": "ts-node database/migrations/finanzas/run.ts",
    "seed": "ts-node database/seeds/finanzas/run.ts"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.24.6",
    "pdfjs-dist": "3.11.174"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.12.12",
    "rimraf": "^5.0.10",
    "ts-node-dev": "^2.0.0",
    "tslint": "^6.1.3",
    "typescript": "^5.4.5"
  }
}
